# WHAP Hyperlocal Micro-Task Marketplace
# Environment Configuration Template
# Duplicate this file to .env.local and populate with your credentials.

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Remote Supabase project URL (e.g. https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public API Key (safe for browser frontend client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Backend tests/migrations ONLY - NEVER expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
